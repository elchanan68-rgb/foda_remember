# Copy to supabase/functions/.env for local Edge Function development.
# Never commit the copied .env file. Add production secrets in Supabase Dashboard.
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
ALLOWED_ORIGINS=http://localhost:5500,https://your-family-site.example
FAMILY_AUTO_APPROVE_CODE=replace-with-a-long-random-family-code
FAMILY_DELETE_CODE=replace-with-a-separate-long-random-manager-delete-code
